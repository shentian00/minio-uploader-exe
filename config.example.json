{
  "_说明": "复制本文件为 config.json 后按实际情况修改。各配置项含义见 README.md 或 操作手册.txt。路径里的反斜杠要写两个",
  "Endpoint": "http://your-minio-host:9000",
  "AccessKey": "YOUR_ACCESS_KEY",
  "SecretKey": "YOUR_SECRET_KEY",
  "Region": "us-east-1",
  "Bucket": "your-bucket",
  "ObjectPrefix": "photos",
  "SourceDir": "D:\\photos",
  "FailedDir": "D:\\photos_failed",
  "DataDir": "data",
  "Extensions": [".jpg", ".jpeg", ".bmp"],
  "UploadThreads": 4,
  "ScanIntervalSeconds": 10,
  "StableSeconds": 30,
  "MaxFailures": 5,
  "RetryDelaySeconds": 10,
  "RequestTimeoutSeconds": 120,
  "KeepLocalDays": 1,
  "UploadFromDate": "",
  "CleanEmptyDirs": false,
  "EmptyDirMinAgeHours": 48,
  "LogRetentionDays": 30
}
